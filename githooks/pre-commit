#!/bin/sh
# pre-commit hook - clang-tidy static analysis on staged .cpp/.hpp files in Src/
#
# Install:  git config core.hooksPath githooks
#
# Prerequisites:
#   - compile_commands.json in project root (generated by "generate-compile-commands.cmd")
#   - Clang 18 at C:\Program Files\clang+llvm-18.1.8-x86_64-pc-windows-msvc
#   - VS 2022 v17 toolchain at E:\Program Files\Microsoft Visual Studio\2022\Community

TIDY="/c/Program Files/clang+llvm-18.1.8-x86_64-pc-windows-msvc/bin/clang-tidy.exe"
VC_INSTALL="E:\\Program Files\\Microsoft Visual Studio\\2022\\Community\\VC\\Tools\\MSVC\\14.29.30133"
COMPDB="$(pwd)/compile_commands.json"

if [ ! -f "$TIDY" ]; then
    echo "[pre-commit] ERROR: clang-tidy not found at $TIDY"
    exit 1
fi

if [ ! -f "$COMPDB" ]; then
    echo "[pre-commit] ERROR: compile_commands.json not found."
    echo "[pre-commit] Run generate-compile-commands.cmd first."
    exit 1
fi

export VCToolsInstallDir="$VC_INSTALL"

# Extract the .cpp translation units listed in the compile database.
TUS=$(grep -oE '"file": *"[^"]+\.cpp"' "$COMPDB" | sed -E 's/.*\/([^\/"]+\.cpp)"/\1/' | sort -u)

HAS_ERRORS=0

for f in $(git diff --cached --name-only --diff-filter=ACM); do
    case "$f" in
        *.cpp|*.hpp) ;;
        *) continue ;;
    esac
    if ! echo "$f" | grep -qiE '^[Ss]rc/'; then
        continue
    fi

    base=$(basename "$f")
    echo "[pre-commit] checking $f ..."

    ERR_LINES=""
    case "$f" in
        *.hpp)
            # Headers cannot be analyzed standalone (missing include context).
            # Run clang-tidy on each TU that includes the header and keep only
            # diagnostics that originate from the header itself.
            for tu in $TUS; do
                OUT=$("$TIDY" -p "$(pwd)" --quiet --header-filter="$base" "$tu" 2>&1)
                ERR_LINES="$ERR_LINES
$(echo "$OUT" | grep -i "error:" | grep -i "$base")"
                if echo "$OUT" | grep -qi "error:.*$base"; then
                    break
                fi
            done
            ;;
        *.cpp)
            OUT=$("$TIDY" -p "$(pwd)" --quiet --header-filter="Src/" "$f" 2>&1)
            ERR_LINES=$(echo "$OUT" | grep -i "error:")
            ;;
    esac

    if echo "$ERR_LINES" | grep -q "error:"; then
        echo "[pre-commit] ERROR: clang-tidy found issues in $f"
        echo "$ERR_LINES" | grep "error:" | head -40
        HAS_ERRORS=1
    elif echo "$OUT" | grep -q "warning: Src/"; then
        echo "[pre-commit] WARNING: clang-tidy warnings in $f"
    fi
done

# Lua scripts: reject C++-style // comments (fatal Lua syntax error,
# breaks the entire script load). Excludes http:// URLs.
for f in $(git diff --cached --name-only --diff-filter=ACM); do
    case "$f" in
        *.lua) ;;
        *) continue ;;
    esac
    if git show :"$f" | grep -n "//" | grep -v "http" | grep -q .; then
        echo "[pre-commit] ERROR: C++-style // comment in $f (use -- in Lua)"
        git show :"$f" | grep -n "//" | grep -v "http" | head -5
        HAS_ERRORS=1
    fi
done

if [ "$HAS_ERRORS" = "1" ]; then
    echo "[pre-commit] Commit blocked. Fix the errors above and try again."
    exit 1
fi

exit 0
